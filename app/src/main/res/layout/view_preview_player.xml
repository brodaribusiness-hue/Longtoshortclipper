<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView is deliberate here. The Compose 9:16 output preview applies a
  scale/translation crop to this AndroidView; SurfaceView content is composed
  in a separate surface and cannot reliably be clipped/transformed with its
  Compose parent on every Android version.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="false" />
